# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# Reasoning effort for o-series / thinking models: none|low|medium|high|xhigh
REASONING_EFFORT=medium

# Supabase — get these from your project's API settings
# https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Lock page — set all three to enable the login gate (leave blank to disable)
APP_EMAIL=your@email.com
APP_PASSWORD=your_password_here
SESSION_SECRET=generate_with: openssl rand -hex 32

# Webhook — Chrome extension must send this in the X-Webhook-Secret header (leave blank to disable auth)
WEBHOOK_SECRET=generate_with: openssl rand -hex 32

# Webhook auto-generation — if set, the webhook will generate a resume for every incoming job
# DEFAULT_TEMPLATE_ID: UUID of the docx_templates row to use
# BACKGROUND_INFO: your full background/resume text (can be multi-line, use \n)
DEFAULT_TEMPLATE_ID=
BACKGROUND_INFO=

# Google Drive — OAuth2 credentials for storing generated resumes
# 1. Create an OAuth2 client ID in Google Cloud Console (Web application type)
# 2. Add https://developers.google.com/oauthplayground as an authorized redirect URI
# 3. Go to OAuth Playground → use your own credentials → authorize Drive API v3
# 4. Exchange the auth code for tokens and copy the refresh_token
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
